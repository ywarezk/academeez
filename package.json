      "picomatch@^2.3.1": "2.3.2",
      "picomatch@^4.0.0": "4.0.4",
      "mermaid>dompurify": "3.4.17",
      "form-data": "4.0.6",
      "js-yaml": "4.3.2",
      "nanoid": "3.3.18",
      "@babel/core": "7.29.7",
      "mermaid>uuid": "11.1.1",
      "eslint>@humanfs/node": "0.16.8",
      "defu": "6.1.7",
      "postcss-selector-parser@6": "6.1.5",
      "yaml": "2.8.3",
      "smol-toml": "1.9.0",
      "source-map-js": "1.2.2",
      "fast-uri": "3.1.9",
