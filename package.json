  "nyc": {
    "temp-dir": ".nyc_output",
    "report-dir": "coverage",
    "reporter": [
      "lcov"
    ],
    "extension": [
      ".ts",
      ".tsx",
      ".js",
      ".jsx"
    ],
    "exclude": [
      "**/*.spec.*",
      "**/*.test.*",
      "playwright.config.*",
      "tests/**"
    ],
    "include": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.js",
      "src/**/*.jsx"
    ],
    "all": true
  }
